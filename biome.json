{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!vite.config.ts",
      "!!apps/desktop/electron.vite.config.ts",
      "!!apps/desktop/vite.config.web.ts",
      "!!apps/desktop/quality-gates/electron.vite.config.ts",
      "!!apps/desktop/src/app/navigation.ts",
      "!!apps/desktop/src/app/settingsNavigation.ts",
      "!!apps/desktop/src/app/router.tsx",
      "!!apps/desktop/src/ui/layout/ScreenLoading.tsx",
      "!!**/dist",
      "!!**/out",
      "!!**/out-web",
      "!!**/release",
      "!!**/resources/binaries",
      "!!**/ios",
      "!!**/android",
      "!!**/.expo",
      "!!apps/mobile/dist-export",
      "!!config/models",
      "!!.agents",
      "!!.claude",
      "!!skills",
      "!!docs/generated",
      "!!crates/cowork-protocol/src/ws_jsonrpc_schema.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "error",
        "noRenderReturnValue": "error",
        "noVoidElementsWithChildren": "error"
      },
      "style": {
        "useImportType": "warn",
        "noNonNullAssertion": "warn",
        "noUselessElse": "error"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noAssignInExpressions": "error",
        "noArrayIndexKey": "error",
        "noEmptyBlock": "error",
        "noEmptyBlockStatements": "error",
        "noUnnecessaryConditions": "error"
      },
      "complexity": {
        "noStaticOnlyClass": "off",
        "noBannedTypes": "error",
        "noUselessCatch": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["test/**", "apps/desktop/test/**", "apps/desktop/quality-gates/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noEmptyBlockStatements": "off",
            "noUnnecessaryConditions": "off"
          }
        }
      }
    },
    {
      "includes": ["docs/generated/**"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["test/**", "apps/desktop/test/**", "scripts/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useYield": "off",
            "noUnusedFunctionParameters": "off",
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noThenProperty": "off",
            "noTemplateCurlyInString": "off",
            "noShadowRestrictedNames": "off",
            "useIterableCallbackReturn": "off",
            "noAssignInExpressions": "off"
          },
          "style": {
            "noNonNullAssertion": "off",
            "useTemplate": "off"
          },
          "a11y": {
            "useButtonType": "off"
          },
          "complexity": {
            "noBannedTypes": "off",
            "useLiteralKeys": "off",
            "useIndexOf": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/src/ui/FilePreviewModal.tsx"],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/components/ui/**",
        "apps/desktop/src/components/ai-elements/**"
      ],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["apps/desktop/src/ui/markdown/DesktopMarkdown.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off",
            "noSvgWithoutTitle": "off",
            "useSemanticElements": "off"
          },
          "correctness": {
            "noChildrenProp": "off",
            "useExhaustiveDependencies": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/mobile/src/components/thread/**",
        "apps/mobile/src/app/(app)/(tabs)/(settings)/settings/providers.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/ui/file-explorer/WorkspaceFileExplorer.tsx",
        "apps/desktop/src/ui/ChatView.tsx",
        "apps/mobile/src/app/(pairing)/index.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/src/ui/settings/pages/BackupPage.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/src/ui/settings/pages/ProvidersPage.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/app/store.helpers/controlSocket.ts",
        "apps/desktop/src/app/store.helpers/jsonRpcSocket.ts",
        "apps/desktop/src/app/store.helpers.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["src/types.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/ui/settings/pages/WorkspacesPage.tsx",
        "apps/mobile/src/app/(app)/(tabs)/(chats)/thread/\\[id\\].tsx",
        "apps/mobile/src/features/cowork/providerStore.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**", "examples/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off",
            "noUnusedFunctionParameters": "off"
          },
          "complexity": {
            "noUselessSwitchCase": "off"
          },
          "style": {
            "useTemplate": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "error",
            "noUnusedVariables": "error",
            "noUnusedFunctionParameters": "error"
          }
        }
      }
    },
    {
      "includes": ["src/shared/displayCitationMarkers.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/src/ui/Canvas.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useFocusableInteractive": "off",
            "noStaticElementInteractions": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
