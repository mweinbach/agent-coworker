{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "dependencies": "off",
    "optionalPeerDependencies": "off",
    "unlisted": "off",
    "unresolved": "off",
    "binaries": "off",
    "duplicates": "off"
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "test/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"],
      "ignore": ["src/generated/**"]
    },
    "packages/harness": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/mobile": {
      "entry": ["index.js", "src/app/**/*.{ts,tsx}", "plugins/*.js"],
      "project": ["src/**/*.{ts,tsx}", "plugins/*.js"]
    }
  }
}
