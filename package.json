{
  "name": "agent-coworker",
  "version": "1.3.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "cargo build --quiet -p cowork-server --bin cowork-server && cargo run --quiet -p cowork-desktop --bin cowork-desktop --",
    "cli": "cargo run --quiet -p cowork-cli --bin cowork --",
    "serve": "cargo run --quiet -p cowork-server --bin cowork-server --",
    "dev:rpc": "cargo run --quiet -p cowork-server --bin cowork-server -- --host 127.0.0.1 --port 7337",
    "desktop:rune": "cargo build --quiet -p cowork-server --bin cowork-server && cargo run --quiet -p cowork-desktop --bin cowork-desktop --",
    "desktop:rune:package": "bun scripts/desktop_rune_package.ts",
    "setup:runtime": "bun scripts/setup_cowork_runtime.ts",
    "build:server-binary": "bun scripts/build_cowork_server_binary.ts",
    "app:mobile:dev": "cd apps/mobile && npx expo start --dev-client",
    "app:mobile:ios": "cd apps/mobile && npx expo run:ios",
    "app:mobile:android": "cd apps/mobile && npx expo run:android",
    "app:mobile:xcode": "bun scripts/open_xcode_workspace.ts",
    "app:mobile:typecheck": "cd apps/mobile && bun run typecheck",
    "build:desktop-resources": "bun scripts/build_desktop_resources.ts",
    "docs:check": "bun packages/harness/src/check_docs.ts",
    "providers:generate": "bun packages/harness/src/generate_provider_specs.ts",
    "providers:check": "bun packages/harness/src/generate_provider_specs.ts --check",
    "harness:run": "bun packages/harness/src/run_raw_agent_loops.ts",
    "test": "bun scripts/run_tests.ts",
    "clean": "bun scripts/clean.ts",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome lint .",
    "format": "bunx biome format .",
    "format:write": "bunx biome format --write .",
    "check": "bunx biome check .",
    "check:write": "bunx biome check --write .",
    "knip": "knip --no-config-hints",
    "complexity": "bun scripts/complexity.ts",
    "complexity:compare": "bun scripts/complexityCompare.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "bun-types": "^1.4.0",
    "electron-updater": "6.8.9",
    "jsdom": "^29.1.1",
    "knip": "^6.32.2",
    "typescript": "^7.0.2"
  }
}
